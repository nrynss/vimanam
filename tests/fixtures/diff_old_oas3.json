{
  "openapi": "3.0.0",
  "info": {
    "title": "Widgets API",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "Widgets", "description": "Widget operations" },
    { "name": "Legacy", "description": "Retired operations" }
  ],
  "paths": {
    "/widgets": {
      "get": {
        "tags": ["Widgets"],
        "summary": "List widgets",
        "operationId": "Widgets_ListWidgets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of widgets",
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "A widget",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Widget" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Widgets"],
        "summary": "Create a widget",
        "operationId": "Widgets_CreateWidget",
        "parameters": [
          {
            "name": "X-Trace",
            "in": "header",
            "description": "Trace identifier",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Widget to create",
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WidgetInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Widget" }
              }
            }
          }
        }
      }
    },
    "/widgets/{id}": {
      "get": {
        "tags": ["Widgets"],
        "summary": "Get a widget",
        "operationId": "Widgets_GetWidget",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Widget identifier",
            "schema": { "type": "string" }
          },
          {
            "name": "fields",
            "in": "query",
            "description": "Fields to return",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "The widget",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Widget" }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "tags": ["Widgets"],
        "summary": "Delete a widget",
        "operationId": "Widgets_DeleteWidget",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Widget identifier",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/legacy": {
      "get": {
        "tags": ["Legacy"],
        "summary": "Legacy ping",
        "operationId": "Legacy_Ping",
        "deprecated": true,
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "description": "Widget identifier" },
          "name": { "type": "string", "description": "Display name" },
          "weight": { "type": "number", "format": "float" },
          "status": { "type": "string", "enum": ["active", "retired"] }
        }
      },
      "WidgetInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "description": "Display name" },
          "weight": { "type": "number", "format": "float", "description": "Weight in kg" }
        }
      }
    }
  }
}
