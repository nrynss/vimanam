{
  "openapi": "3.0.0",
  "info": {
    "title": "Hygiene API",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "Users", "description": "User accounts" },
    { "name": "Health" }
  ],
  "paths": {
    "/health": {
      "get": {
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "List users",
        "operationId": "listUsers",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "A list of users" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create a user",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "type": "object" } }
          }
        }
      }
    },
    "/users/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "get": {
        "tags": ["Users"],
        "description": "Fetch a single user by ID",
        "operationId": "getUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "User ID",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "The user" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete a user",
        "operationId": "getUser",
        "deprecated": true,
        "responses": {
          "204": { "description": "Deleted" }
        }
      }
    },
    "/ping": {
      "get": {
        "tags": ["Health"],
        "summary": "Ping",
        "operationId": "ping",
        "deprecated": true,
        "responses": {
          "200": { "description": "pong" }
        }
      }
    }
  }
}
